{
  "formatVersion": 1,
  "postgresql": "18.6",
  "extensions": {
    "vector": "0.8.6",
    "vectorscale": "0.9.1"
  },
  "scalarVector": {
    "maximumDimensions": 16000,
    "operators": ["<=>", "<->", "<#>"],
    "storedZeroCosine": "null"
  },
  "indexes": {
    "hnsw": {
      "extension": "vector",
      "maximumDimensions": 2000,
      "operatorClasses": [
        "vector_cosine_ops",
        "vector_l2_ops",
        "vector_ip_ops"
      ],
      "buildOptions": {
        "m": {"minimum": 2, "maximum": 100},
        "efConstruction": {"minimum": 4, "maximum": 1000}
      },
      "concurrentBuild": false
    }
  }
}
