{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inframe.dev/rivet/migrations/v1/snapshot.schema.json",
  "title": "Rivet physical snapshot version 1",
  "type": "object",
  "required": ["formatVersion", "dialect", "databaseId", "migrationId", "schemas", "tables", "enums", "requirements"],
  "properties": {
    "formatVersion": {"const": 1},
    "dialect": {"const": "rivet"},
    "databaseId": {"$ref": "#/$defs/id"},
    "migrationId": {"$ref": "#/$defs/id"},
    "schemas": {"type": "array", "items": {"$ref": "#/$defs/named"}},
    "tables": {"type": "array", "items": {"type": "object", "required": ["id", "schemaId", "name", "columns", "indexes", "constraints"]},
    "enums": {"type": "array", "items": {"type": "object", "required": ["id", "schemaId", "name", "values"]}},
    "requirements": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "named": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}},
      "additionalProperties": false
    }
  }
}
