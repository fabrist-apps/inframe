{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inframe.dev/rivet/migrations/v1/expression.schema.json",
  "title": "Rivet schema expression version 1",
  "type": "object",
  "required": ["formatVersion", "kind"],
  "properties": {
    "formatVersion": {"const": 1},
    "kind": {"enum": ["literal", "reference", "operator", "function"]},
    "value": {},
    "objectId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "operator": {"type": "string"},
    "name": {"type": "string"},
    "arguments": {"type": "array", "items": {"$ref": "#"}}
  },
  "additionalProperties": false
}
