import 'dart:async';
import 'dart:io';

import 'package:flutter/foundation.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:integration_test/integration_test.dart';
import 'package:turso/turso.dart';

void main() {
  IntegrationTestWidgetsFlutterBinding.ensureInitialized();

  group('Turso Flutter native runtime', () {
    testWidgets('should persist exact bound values and release native files', (_) async {
      final directory = Directory.systemTemp.createTempSync('turso-flutter-native-');
      addTearDown(() {
        if (directory.existsSync()) directory.deleteSync(recursive: true);
      });

      final path = '${directory.path}/database.turso';
      final maximumInteger = BigInt.parse('9223372036854775807');
      final database = await TursoDatabase.open(TursoLocation.file(path));
      await database.execute(
        'CREATE TABLE values_table ('
        'id INTEGER PRIMARY KEY, text_value TEXT, real_value REAL, blob_value BLOB)',
      );
      final inputBlob = Uint8List.fromList([1, 2, 3]);
      await database.execute(
        'INSERT INTO values_table VALUES (?, ?, ?, ?)',
        parameters: [maximumInteger, 'mobile', 2.5, inputBlob],
      );
      inputBlob[0] = 99;
      await database.close();
      await database.close();
      await expectLater(database.query('SELECT 1'), throwsStateError);

      final reopened = await TursoDatabase.open(TursoLocation.file(path));
      final result = await reopened.query(
        'SELECT id, text_value, real_value, blob_value FROM values_table WHERE id = :id',
        namedParameters: {':id': maximumInteger},
      );
      expect(result.rows.single.getBigInt('id'), maximumInteger);
      expect(result.rows.single.getString('text_value'), 'mobile');
      expect(result.rows.single.getDouble('real_value'), 2.5);
      expect(result.rows.single.getBlob('blob_value'), [1, 2, 3]);
      expect(() => result.rows.add(result.rows.single), throwsUnsupportedError);
      final outputBlob = result.rows.single.getBlob('blob_value')..[0] = 42;
      expect(outputBlob, [42, 2, 3]);
      expect(result.rows.single.getBlob('blob_value'), [1, 2, 3]);
      await reopened.close();

      directory.deleteSync(recursive: true);
      expect(directory.existsSync(), isFalse);
    });

    testWidgets('should isolate in-memory databases', (_) async {
      final first = await TursoDatabase.open(TursoLocation.memory());
      await first.execute('CREATE TABLE local_only (value INTEGER)');
      await first.close();

      final second = await TursoDatabase.open(TursoLocation.memory());
      addTearDown(second.close);
      await expectLater(
        second.query('SELECT * FROM local_only'),
        throwsA(isA<TursoDatabaseException>()),
      );
      expect((await second.query('SELECT 7 AS value')).rows.single.getInt('value'), 7);
    });

    testWidgets('should attach persistent and memory databases', (_) => _verifyAttachments());

    testWidgets('should enforce binding and result contracts', (_) => _verifyBindingsAndResults());
    testWidgets('should enforce transaction and lifecycle contracts', (_) => _verifyTransactions());
    for (final cipher in TursoCipher.values) {
      testWidgets(
        'should compose ${cipher.name} encryption with FTS and vectors',
        (_) => _verifyEncryptedFeatures(cipher),
      );
    }
  });
}

Future<void> _verifyBindingsAndResults() async {
  final database = await TursoDatabase.open(TursoLocation.memory());
  try {
    final source = Uint8List.fromList([1, 2, 3]);
    final pending = database.query(
      'SELECT ? AS minimum, ? AS maximum, ? AS null_value, ? AS text_value, '
      '? AS real_value, ? AS blob_value, 1 AS duplicate, 2 AS duplicate',
      parameters: [
        BigInt.parse('-9223372036854775808'),
        BigInt.parse('9223372036854775807'),
        null,
        'before',
        7.5,
        source,
      ],
    );
    source[0] = 99;
    final result = await pending;
    final row = result.rows.single;
    expect(row.getBigInt('minimum'), BigInt.parse('-9223372036854775808'));
    expect(row.getBigInt('maximum'), BigInt.parse('9223372036854775807'));
    expect(() => row.getInt('maximum'), throwsRangeError);
    expect(row.value('null_value'), isNull);
    expect(row.getString('text_value'), 'before');
    expect(row.getDouble('real_value'), 7.5);
    expect(row.getBlob('blob_value'), [1, 2, 3]);
    expect(row.valueAt(6), BigInt.one);
    expect(row.valueAt(7), BigInt.two);
    expect(() => row.value('duplicate'), throwsStateError);
    expect(() => row.valueAt(8), throwsRangeError);
    expect(() => row.getString('missing'), throwsArgumentError);
    expect(result.columns.clear, throwsUnsupportedError);

    await expectLater(database.query('SELECT ?'), throwsArgumentError);
    await expectLater(
      database.query('SELECT ?', parameters: const [true]),
      throwsArgumentError,
    );
    await expectLater(
      database.query('SELECT ?', parameters: const [double.nan]),
      throwsArgumentError,
    );
    await expectLater(
      database.query('SELECT ?', parameters: [BigInt.parse('9223372036854775808')]),
      throwsArgumentError,
    );
    await expectLater(database.query('SELECT 1; SELECT 2'), throwsArgumentError);
    await expectLater(
      database.query(
        'SELECT :value',
        parameters: const [1],
        namedParameters: const {':value': 1},
      ),
      throwsArgumentError,
    );
    final repeated = await database.query(
      'SELECT :value + :value AS value',
      namedParameters: const {':value': 2},
    );
    expect(repeated.rows.single.getInt('value'), 4);

    await database.execute('CREATE TABLE changed (value INTEGER)');
    final changed = await database.execute(
      'INSERT INTO changed VALUES (1), (2) RETURNING value',
    );
    expect(changed.rowsAffected, BigInt.two);
    final returned = await database.query(
      'INSERT INTO changed VALUES (3) RETURNING value',
    );
    expect(returned.rows.single.getInt('value'), 3);
  } finally {
    await database.close();
  }
}

Future<void> _verifyAttachments() async {
  final directory = Directory.systemTemp.createTempSync('turso-attachments-');
  final mainPath = '${directory.path}/main.turso';
  final attachedPath = '${directory.path}/attached.turso';
  try {
    final database = await TursoDatabase.open(TursoLocation.file(mainPath));
    expect(
      (await database.query('PRAGMA foreign_keys')).rows.single.getInt('foreign_keys'),
      0,
    );
    await database.execute(
      'ATTACH DATABASE ? AS auxiliary',
      parameters: [attachedPath],
    );
    await database.execute('PRAGMA foreign_keys=ON');
    await database.execute('CREATE TABLE auxiliary.parents (id INTEGER PRIMARY KEY)');
    await database.execute(
      'CREATE TABLE auxiliary.children ('
      'id INTEGER PRIMARY KEY, parent_id INTEGER REFERENCES parents(id))',
    );
    await database.execute('INSERT INTO auxiliary.parents VALUES (1)');
    await database.execute('INSERT INTO auxiliary.children VALUES (1, 1)');
    await expectLater(
      database.execute('INSERT INTO auxiliary.children VALUES (2, 99)'),
      throwsA(isA<TursoDatabaseException>()),
    );
    expect(
      (await database.query(
        'SELECT children.id AS id FROM auxiliary.children '
        'JOIN auxiliary.parents ON parents.id = children.parent_id',
      )).rows.single.getInt('id'),
      1,
    );
    await database.execute('DETACH DATABASE auxiliary');
    await database.execute(
      'ATTACH DATABASE ? AS auxiliary',
      parameters: [attachedPath],
    );
    expect(
      (await database.query('SELECT id FROM auxiliary.children')).rows.single.getInt('id'),
      1,
    );
    await database.execute('DETACH DATABASE auxiliary');
    await database.execute("ATTACH DATABASE ':memory:' AS scratch");
    await database.execute('CREATE TABLE scratch.items (id INTEGER PRIMARY KEY)');
    await database.execute('INSERT INTO scratch.items VALUES (7)');
    expect((await database.query('SELECT id FROM scratch.items')).rows.single.getInt('id'), 7);
    await database.close();

    final attached = await TursoDatabase.open(TursoLocation.file(attachedPath));
    expect((await attached.query('SELECT id FROM children')).rows.single.getInt('id'), 1);
    await attached.close();
  } finally {
    directory.deleteSync(recursive: true);
  }
}

Future<void> _verifyTransactions() async {
  final database = await TursoDatabase.open(TursoLocation.memory());
  final other = await TursoDatabase.open(TursoLocation.memory());
  try {
    await database.execute('CREATE TABLE events (value TEXT)');
    final entered = Completer<void>();
    final release = Completer<void>();
    late TursoTransaction expired;
    final transaction = database.transaction((tx) async {
      expired = tx;
      await tx.execute(
        'INSERT INTO events VALUES (?)',
        parameters: const ['transaction'],
      );
      await expectLater(database.query('SELECT 1'), throwsStateError);
      await expectLater(database.close(), throwsStateError);
      expect((await other.query('SELECT 1 AS value')).rows.single.getInt('value'), 1);
      entered.complete();
      await release.future;
      return 42;
    });
    await entered.future;
    var rootCompleted = false;
    final root = database.query('SELECT count(*) AS count FROM events').whenComplete(() {
      rootCompleted = true;
    });
    await Future<void>.delayed(Duration.zero);
    expect(rootCompleted, isFalse);
    release.complete();
    expect(await transaction, 42);
    expect((await root).rows.single.getInt('count'), 1);
    await expectLater(expired.query('SELECT 1'), throwsStateError);

    await expectLater(
      database.transaction((tx) async {
        await tx.execute(
          'INSERT INTO events VALUES (?)',
          parameters: const ['rolled back'],
        );
        throw const _ExpectedRollback();
      }),
      throwsA(isA<_ExpectedRollback>()),
    );
    expect(
      (await database.query('SELECT count(*) AS count FROM events')).rows.single.getInt('count'),
      1,
    );
  } finally {
    await database.close();
    await other.close();
  }
}

final class _ExpectedRollback implements Exception {
  const _ExpectedRollback();
}

Future<void> _verifyEncryptedFeatures(TursoCipher cipher) async {
  final directory = Directory.systemTemp.createTempSync('turso-encrypted-fts-');
  try {
    await _runEncryptedFeatures(directory, cipher);
  } finally {
    directory.deleteSync(recursive: true);
  }
}

Uint8List _encryptionKey() => Uint8List.fromList(List<int>.generate(32, (index) => index + 1));

Future<void> _runEncryptedFeatures(Directory directory, TursoCipher cipher) async {
  final location = TursoLocation.file('${directory.path}/database.turso');
  final encryption = TursoEncryption(cipher: cipher, key: _encryptionKey());
  final rssBefore = ProcessInfo.currentRss;
  final database = await TursoDatabase.open(location, encryption: encryption);
  expect(database.capabilities.fts, isTrue);
  expect(database.capabilities.vectorFunctions, isTrue);
  expect(database.capabilities.vectorIndexes, isFalse);
  await database.execute("ATTACH DATABASE ':memory:' AS auxiliary");
  await database.execute('CREATE TABLE auxiliary.items (id INTEGER PRIMARY KEY)');
  await database.execute('INSERT INTO auxiliary.items VALUES (1)');
  expect((await database.query('SELECT id FROM auxiliary.items')).rows.single.getInt('id'), 1);
  await database.execute('DETACH DATABASE auxiliary');
  await database.execute('CREATE TABLE documents (id INTEGER PRIMARY KEY, body TEXT)');
  await database.execute('CREATE INDEX documents_fts ON documents USING fts (body)');
  await database.execute(
    "WITH RECURSIVE sequence(value) AS ("
    "SELECT 1 UNION ALL SELECT value + 1 FROM sequence WHERE value < 2000) "
    "INSERT INTO documents SELECT value, 'searchable needle ' || value FROM sequence",
  );
  await expectLater(
    database.transaction((tx) async {
      await tx.execute(
        'INSERT INTO documents VALUES (?, ?)',
        parameters: const [2001, 'rolled back needle'],
      );
      throw const _ExpectedRollback();
    }),
    throwsA(isA<_ExpectedRollback>()),
  );
  final vector = await database.query(
    "SELECT vector_distance_l2(vector32('[0, 0]'), vector32('[3, 4]')) AS distance",
  );
  expect(vector.rows.single.getDouble('distance'), closeTo(5.0, 0.01));
  await database.close();

  final wrongKey = _encryptionKey()..[0] ^= 0xff;
  await expectLater(
    TursoDatabase.open(
      location,
      encryption: TursoEncryption(cipher: cipher, key: wrongKey),
    ),
    throwsA(isA<TursoDatabaseException>()),
  );
  await expectLater(
    TursoDatabase.open(location),
    throwsA(isA<TursoDatabaseException>()),
  );
  final reopened = await TursoDatabase.open(location, encryption: encryption);
  final matches = await reopened.query(
    "SELECT count(*) AS count FROM documents WHERE fts_match(body, 'needle')",
  );
  expect(matches.rows.single.getInt('count'), 2000);
  await reopened.close();
  debugPrint(
    'TURSO_FTS_MEMORY cipher=${cipher.name} rows=2000 '
    'rss_before=$rssBefore rss_after=${ProcessInfo.currentRss}',
  );
}
